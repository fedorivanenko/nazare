<section>
  {% render 'product-gallery', product: product %}
  <h1>{{ product.title }}</h1>
  {% render 'price', product: product %}
  <form action="{{ routes.cart_add_url }}" method="post">
    <select name="id">
      {% for variant in product.variants %}
        <option value="{{ variant.id }}">{{ variant.title }}</option>
      {% endfor %}
    </select>
    <button type="submit">{{ 'product.add_to_cart' | t }}</button>
  </form>
  {% if section.settings.show_recommendations %}
    {% render 'recommendations' %}
  {% endif %}
  {% content_for 'blocks' %}
</section>
{% schema %}
{
  "name": "Main product",
  "settings": [{ "id": "show_recommendations", "type": "checkbox", "label": "Recommendations" }],
  "blocks": [{ "type": "text", "name": "Text" }, { "type": "image", "name": "Image" }]
}
{% endschema %}
