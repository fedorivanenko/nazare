{% component snippet %}

{% props {
  label: string.required(),
  url: url.optional(),
  scheme: string.enum("solid", "outline", "ghost").default("solid"),
  size: string.enum("sm", "md").default("md"),
  tag: string.enum("a", "button", "span").default("a"),
  type: string.enum("button", "submit", "reset").default("button"),
  name: string.optional(),
  class: string.optional(),
  attributes: string.optional(),
} %}

{% comment %}
  Nazare materializes defaults when arguments are nil. These enum guards handle
  invalid values from ordinary Liquid callers that bypass Nazare's checker.
{% endcomment %}
{% assign button_scheme = props.scheme %}
{% unless button_scheme == "solid" or button_scheme == "outline" or button_scheme == "ghost" %}
  {% assign button_scheme = "solid" %}
{% endunless %}
{% assign button_size = props.size %}
{% unless button_size == "sm" or button_size == "md" %}
  {% assign button_size = "md" %}
{% endunless %}
{% assign button_tag = props.tag %}
{% unless button_tag == "a" or button_tag == "button" or button_tag == "span" %}
  {% assign button_tag = "a" %}
{% endunless %}
{% assign button_type = props.type %}
{% unless button_type == "button" or button_type == "submit" or button_type == "reset" %}
  {% assign button_type = "button" %}
{% endunless %}
{% assign button_class = "nazare-button nazare-button--" | append: button_scheme | append: " nazare-button--" | append: button_size %}
{% if props.class != blank %}
  {% assign button_class = button_class | append: " " | append: props.class %}
{% endif %}

{% if props.label != blank %}
  {% if button_tag == "button" %}
    <button
      class="{{ button_class }}"
      type="{{ button_type }}"
      {% if props.name != blank %}name="{{ props.name }}"{% endif %}
      {{ props.attributes }}
    >{{ props.label }}</button>
  {% elsif button_tag == "span" %}
    <span class="{{ button_class }}" {{ props.attributes }}>{{ props.label }}</span>
  {% elsif props.url != blank %}
    <a class="{{ button_class }}" href="{{ props.url }}" {{ props.attributes }}>{{ props.label }}</a>
  {% endif %}
{% endif %}

{% stylesheet %}
.nazare-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid transparent;
  border-radius: 9999px;
  font-size: 14px;
  line-height: 20px;
  font-weight: 500;
  white-space: nowrap;
  text-decoration: none;
  cursor: pointer;
  transition: color 150ms, background-color 150ms, border-color 150ms;
}

.nazare-button--md {
  padding: 12px 60px;
  text-transform: uppercase;
}

.nazare-button--sm {
  padding: 8px 20px;
}

.nazare-button--solid {
  background-color: var(--btn-bg, var(--color-foreground, #111111));
  color: var(--btn-text, var(--color-background, #ffffff));
}

.nazare-button--solid:hover {
  background-color: var(--color-accent, #2563eb);
  color: var(--color-accent-foreground, #ffffff);
}

.nazare-button--outline {
  background-color: transparent;
  border-color: currentColor;
  color: inherit;
}

.nazare-button--outline:hover {
  color: var(--color-accent, #2563eb);
}

.nazare-button--ghost {
  background-color: transparent;
  border-color: transparent;
  color: inherit;
  text-decoration: underline;
  text-underline-offset: 4px;
  padding-inline: 0;
}

.nazare-button--ghost:hover {
  color: var(--color-accent, #2563eb);
}

.nazare-button:focus {
  outline: none;
}

.nazare-button:focus-visible {
  outline: none;
  box-shadow:
    0 0 0 2px var(--color-background, #ffffff),
    0 0 0 4px var(--color-ring, currentColor);
}
{% endstylesheet %}
