	"scripts": {
		"typecheck": "tsc -p tsconfig.json"
	},
	"dependencies": {
		"@nazare/core": "workspace:^",
		"@nazare/source": "workspace:^",
		"acorn": "^8.15.0",
		"acorn-walk": "^8.3.4",
