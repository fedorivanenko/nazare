		},
		"./project": {
			"types": "./dist/project/index.d.ts",
			"import": "./dist/project/index.js"
		},
		"./output": {
			"types": "./dist/output/index.d.ts",
			"import": "./dist/output/index.js"
		},
		"./portable": {
			"types": "./dist/portable/index.d.ts",
