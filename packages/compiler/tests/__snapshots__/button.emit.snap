=== snippets/button.liquid ===
{%- comment -%}
Generated by Nazare from registry/components/button/button.nz.liquid — do not edit.
{%- endcomment -%}
{% if scheme == nil %}
  {% assign scheme = "solid" %}
{% endif %}
{% if size == nil %}
  {% assign size = "md" %}
{% endif %}
{% if tag == nil %}
  {% assign tag = "a" %}
{% endif %}
{% if type == nil %}
  {% assign type = "button" %}
{% endif %}
{% comment %}
  Nazare materializes defaults when arguments are nil. These enum guards handle
  invalid values from ordinary Liquid callers that bypass Nazare's checker.
{% endcomment %}
{% assign button_scheme = scheme %}
{% unless button_scheme == "solid" or button_scheme == "outline" or button_scheme == "ghost" %}
  {% assign button_scheme = "solid" %}
{% endunless %}
{% assign button_size = size %}
{% unless button_size == "sm" or button_size == "md" %}
  {% assign button_size = "md" %}
{% endunless %}
{% assign button_tag = tag %}
{% unless button_tag == "a" or button_tag == "button" or button_tag == "span" %}
  {% assign button_tag = "a" %}
{% endunless %}
{% assign button_type = type %}
{% unless button_type == "button" or button_type == "submit" or button_type == "reset" %}
  {% assign button_type = "button" %}
{% endunless %}
{% assign button_class = "nazare-button nazare-button--" | append: button_scheme | append: " nazare-button--" | append: button_size %}
{% if class != blank %}
  {% assign button_class = button_class | append: " " | append: class %}
{% endif %}

{% if label != blank %}
  {% if button_tag == "button" %}
    <button
      class="{{ button_class }}"
      type="{{ button_type }}"
      {% if name != blank %}name="{{ name }}"{% endif %}
      {{ attributes }}
    >{{ label }}</button>
  {% elsif button_tag == "span" %}
    <span class="{{ button_class }}" {{ attributes }}>{{ label }}</span>
  {% elsif url != blank %}
    <a class="{{ button_class }}" href="{{ url }}" {{ attributes }}>{{ label }}</a>
  {% endif %}
{% endif %}
