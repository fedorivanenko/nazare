=== assets/button.css ===

.nazare-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid transparent;
  border-radius: 9999px;
  font-size: 14px;
  line-height: 20px;
  font-weight: 500;
  white-space: nowrap;
  text-decoration: none;
  cursor: pointer;
  transition: color 150ms, background-color 150ms, border-color 150ms;
}

.nazare-button--md {
  padding: 12px 60px;
  text-transform: uppercase;
}

.nazare-button--sm {
  padding: 8px 20px;
}

.nazare-button--solid {
  background-color: var(--btn-bg, var(--color-foreground, #111111));
  color: var(--btn-text, var(--color-background, #ffffff));
}

.nazare-button--solid:hover {
  background-color: var(--color-accent, #2563eb);
  color: var(--color-accent-foreground, #ffffff);
}

.nazare-button--outline {
  background-color: transparent;
  border-color: currentColor;
  color: inherit;
}

.nazare-button--outline:hover {
  color: var(--color-accent, #2563eb);
}

.nazare-button--ghost {
  background-color: transparent;
  border-color: transparent;
  color: inherit;
  text-decoration: underline;
  text-underline-offset: 4px;
  padding-inline: 0;
}

.nazare-button--ghost:hover {
  color: var(--color-accent, #2563eb);
}

.nazare-button:focus {
  outline: none;
}

.nazare-button:focus-visible {
  outline: none;
  box-shadow:
    0 0 0 2px var(--color-background, #ffffff),
    0 0 0 4px var(--color-ring, currentColor);
}


