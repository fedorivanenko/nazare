{
  "name": "@nazare/tree-sitter-nazare-liquid",
  "version": "0.1.0",
  "private": true,
  "description": "Tree-sitter Nazare Liquid grammar",
  "license": "MIT",
  "main": "bindings/node",
  "types": "bindings/node",
  "files": [
    "LICENSE",
    "grammar.js",
    "binding.gyp",
    "bindings/node/*",
    "queries/*",
    "src/**"
  ],
  "dependencies": {
    "node-addon-api": "^8.0.0",
    "node-gyp-build": "^4.8.1"
  },
  "peerDependencies": {
    "tree-sitter": "^0.21.1"
  },
  "scripts": {
    "generate": "tree-sitter generate",
    "test": "tree-sitter test",
    "install": "node-gyp-build",
    "prebuildify": "prebuildify --napi --strip"
  },
  "devDependencies": {
    "tree-sitter-cli": "0.22.6",
    "prebuildify": "^6.0.0"
  },
  "tree-sitter": [
    {
      "scope": "source.nazare_liquid",
      "injection-regex": "^nazare_liquid$"
    }
  ]
}
