{%- comment -%}
  The cells are numbered rather than fetched: a section reads its settings, and
  a workbench has no storefront behind it to hand one a collection.
{%- endcomment -%}
<section class="grid-section">
  <h2 class="grid-section__heading">{{ section.settings.heading }}</h2>
  <div class="grid grid--{{ section.settings.columns }}">
    {%- for index in (1..section.settings.columns) -%}
      <div class="grid__cell">Product {{ index }}</div>
    {%- endfor -%}
  </div>
</section>
{{ 'theme.css' | asset_url | stylesheet_tag }}
{% schema %}
{
  "name": "Collection grid",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best sellers" },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    }
  ]
}
{% endschema %}
