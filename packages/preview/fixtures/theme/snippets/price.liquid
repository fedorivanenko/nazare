{% doc %}
  Price, with the compare-at struck through when there is one.

  @param {number} price - Price in minor units, as a storefront gives it.
  @param {number} [compare_at_price] - Was-price, when the item is on sale.
{% enddoc %}
<span class="price">
  <span class="price__current">{{ price | money }}</span>
  {%- if compare_at_price > price -%}
    <s class="price__compare">{{ compare_at_price | money }}</s>
  {%- endif -%}
</span>
