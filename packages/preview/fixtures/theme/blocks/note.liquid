<p class="note note--{{ block.settings.tone }}" style="text-align: {{ block.settings.alignment }}">
  {{ block.settings.text }}
</p>
{% schema %}
{
  "name": "Note",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Free shipping over $50." },
    {
      "type": "select",
      "id": "tone",
      "label": "Tone",
      "default": "info",
      "options": [
        { "value": "info", "label": "Info" },
        { "value": "success", "label": "Success" },
        { "value": "warning", "label": "Warning" }
      ]
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    }
  ]
}
{% endschema %}
