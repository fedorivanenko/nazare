{
	"name": "@nazare/semantic-compiler",
	"version": "0.0.0",
	"private": true,
	"license": "MIT",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"binding.gyp",
		"dist/**",
		"src/parsers/liquid/vendor/tree-sitter-liquid/LICENSE",
		"src/parsers/liquid/vendor/tree-sitter-liquid/src/**"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json && mkdir -p dist/parsers/liquid && cp src/parsers/liquid/grammar.cjs dist/parsers/liquid/grammar.cjs",
		"install": "node-gyp-build",
		"test": "pnpm run build && node --test tests/*.test.mjs",
		"typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.type-tests.json"
	},
	"dependencies": {
		"acorn": "^8.15.0",
		"acorn-walk": "^8.3.4",
		"graphql": "^16.11.0",
		"jsonc-parser": "^3.3.1",
		"node-addon-api": "^8.0.0",
		"node-gyp-build": "^4.8.1",
		"postcss": "^8.5.17",
		"postcss-scss": "^4.0.9",
		"tree-sitter": "0.21.1",
		"tree-sitter-html": "0.23.2"
	}
}
