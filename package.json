{
	"name": "nazare-monorepo",
	"private": true,
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@10.0.0",
	"scripts": {
		"build": "pnpm -r --if-present build",
		"typecheck": "pnpm -r --if-present typecheck",
		"test": "pnpm -r --if-present test",
		"test:registry": "pnpm --filter @nazare/registry test && pnpm --filter @nazare/registry-api test",
		"test:theme-intelligence": "pnpm --filter @nazare/theme-intelligence test",
		"format": "biome format --write .",
		"lint": "biome check .",
		"check:no-dist": "test -z \"$(git ls-files '*/dist/*')\""
	},
	"devDependencies": {
		"@types/node": "^26.1.1",
		"typescript": "^5.5.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@nazare/theme-intelligence",
			"tree-sitter",
			"tree-sitter-html"
		],
		"patchedDependencies": {
			"tree-sitter@0.21.1": "patches/tree-sitter@0.21.1.patch"
		}
	}
}
